# Headers do Cloudflare Pages.
# Formato: caminho na primeira coluna, headers indentados abaixo.
#
# Cache: os arquivos NAO tem hash no nome (styles.css, main.js, foto.jpg).
# Cache longo neles significa que uma troca de foto ou de CSS so aparece
# para o visitante quando o cache dele expira. Por isso os tempos abaixo
# sao conservadores. Se um dia os assets ganharem hash ou ?v= no nome, da
# para subir /images e /manuals para max-age=31536000, immutable.

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
  Permissions-Policy: geolocation=(), microphone=(), camera=()
  Strict-Transport-Security: max-age=604800

# CSS e JS mudam a cada deploy e nao tem hash no nome: sempre revalida.
# O ETag resolve em 304, entao o custo e baixo.
/css/*
  Cache-Control: public, no-cache

/js/*
  Cache-Control: public, no-cache

# Fotos ainda estao sendo trocadas pelas oficiais: cache curto, com
# stale-while-revalidate para nao pesar na navegacao.
/images/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

# Manuais sao pesados (ate 9,6 MB) e mudam raramente.
/manuals/*
  Cache-Control: public, max-age=604800
